{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "company-data/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/v1/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/((?!assets/|logo\\.png|favicon\\.png|elhelb-ai-app-logo\\.png|widget\\.js|website-demo\\.html).*)", "destination": "/index.html" }
  ]
}
