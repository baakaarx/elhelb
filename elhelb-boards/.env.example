# إعدادات بيئة الإنتاج للسيرفر — مجموعة الهلب (ELHELB GROUP)
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# مسار قاعدة البيانات الدائم (يُضبط تلقائياً عبر setup-from-zip.sh أو start-windows-server.bat أو Docker)
DB_PATH=/opt/elhelb-data/elhelb-boards.db

# مفتاح توقيع الجلسات (إلزامي في الإنتاج لا يقل عن 32 حرفاً — يُولَّد تلقائياً عند التشغيل بالسكريبتات المرفقة)
JWT_SECRET=

# اختياري: مفتاح تشفير مستقل (AES-256-GCM) لأسرار Gmail و Google OAuth داخل قاعدة البيانات (يُشتق تلقائياً من JWT_SECRET إن لم يُحدد)
SETTINGS_ENCRYPTION_KEY=

# اختياري: الرابط الرسمي العام للمنصة (مثلاً https://boards.elhelbgroup.com) لمنع تزوير Host Header في OAuth
PUBLIC_BASE_URL=

# اختياري: لتحديد كلمة مرور مبدئية مخصصة لحساب admin عند إنشاء قاعدة بيانات جديدة لأول مرة فقط
ADMIN_INIT_PASSWORD=

# فعّله (1) فقط إذا كان السيرفر خلف Reverse Proxy موثوق مثل Caddy أو Nginx
TRUST_PROXY=0
