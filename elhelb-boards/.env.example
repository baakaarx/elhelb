# إعدادات بيئة الإنتاج للسيرفر — مجموعة الهلب (ELHELB GROUP)
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# مسار قاعدة البيانات الدائم (يُضبط تلقائياً عبر setup-from-zip.sh أو start-windows-server.bat أو Docker)
DB_PATH=/opt/elhelb-data/elhelb-boards.db

# مفتاح توقيع الجلسات (إلزامي في الإنتاج لا يقل عن 32 حرفاً ومستقل عن مفاتيح التخزين — يُولَّد تلقائياً في سكريبتات السيرفر)
JWT_SECRET=

# مفتاح تشفير مستقل (AES-256-GCM) لأسرار Gmail و Google OAuth داخل قاعدة البيانات
SETTINGS_ENCRYPTION_KEY=

# مفتاح تشفير مستقل للنسخ السحابية (Upstash / Vercel Blob / Turso)
CLOUD_ENCRYPTION_KEY=

# كلمة المرور المبدئية لحساب رئيس مجلس الإدارة (@admin) عند تهيئة قاعدة بيانات جديدة في الإنتاج (إلزامية، 10 أحرف فأكثر)
ADMIN_INIT_PASSWORD=

# اختياري للطوارئ فقط: لإعادة تعيين كلمة مرور حساب رئيس مجلس الإدارة (@admin) على سيرفر قائم ثم يُحذف المتغير بعدها
ADMIN_RESET_PASSWORD=

# اختياري: الرابط الرسمي العام للمنصة (مثلاً https://boards.elhelbgroup.com) لمنع تزوير Host Header في OAuth
PUBLIC_BASE_URL=

# تفعيل تمرير البروكسي الموثوق (1 خلف Caddy / Nginx / Vercel / Render / Railway)
TRUST_PROXY=1
